<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_nearby_row"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/entity_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/entity_gender"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="1dp" />

        <TextView
            android:id="@+id/entity_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.55"
            android:text="@string/nearby_level"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <com.rocom.nearby.entity.PingPongScroll
                android:id="@+id/entity_badge_strip"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/entity_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </com.rocom.nearby.entity.PingPongScroll>
        </LinearLayout>

        <TextView
            android:id="@+id/entity_bearing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/entity_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/entity_fight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Space
        android:layout_width="wrap_content"
        android:layout_height="9dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nearby_stat"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/entity_height_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.45"
                android:text="@string/nearby_height_label"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="2dp" />

            <com.rocom.nearby.entity.PingPongScroll
                android:id="@+id/entity_height_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/entity_height"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </com.rocom.nearby.entity.PingPongScroll>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/secondary_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/entity_weight_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.45"
                android:text="@string/nearby_weight_label"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="2dp" />

            <com.rocom.nearby.entity.PingPongScroll
                android:id="@+id/entity_weight_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/entity_weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </com.rocom.nearby.entity.PingPongScroll>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/secondary_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/entity_voice_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.45"
                android:text="@string/nearby_voice_label"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="2dp" />

            <com.rocom.nearby.entity.PingPongScroll
                android:id="@+id/entity_voice_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/entity_voice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </com.rocom.nearby.entity.PingPongScroll>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>