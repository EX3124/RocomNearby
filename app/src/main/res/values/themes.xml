<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Nearby" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:textColorHighlight">@android:color/transparent</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:colorControlActivated">@android:color/black</item>
    </style>

    <style name="Theme.Nearby" parent="Base.Theme.Nearby" />

    <style name="Widget.Nearby.TargetInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundMode">none</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCollapsedPaddingTop">0dp</item>
        <item name="hintEnabled">false</item>
        <item name="errorEnabled">false</item>
        <item name="counterEnabled">false</item>
        <item name="endIconMode">none</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="Widget.Nearby.TargetEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
