<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_body"
    android:layout_width="264dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/overlay_opacity_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_compass" />

            <SeekBar
                android:id="@+id/overlay_opacity_seek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/overlay_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/overlay_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="66dp"
            android:text="@string/overlay_empty"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <ScrollView
            android:id="@+id/overlay_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.rocom.nearby.entity.NearbyListView
                android:id="@+id/overlay_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/nearby_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.rocom.nearby.entity.NearbyListView>
        </ScrollView>

    </LinearLayout>

    <com.rocom.nearby.overlay.OverlayResizeGrip
        android:id="@+id/overlay_resize_start"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|start" />

    <com.rocom.nearby.overlay.OverlayResizeGrip
        android:id="@+id/overlay_resize_end"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end" />

</FrameLayout>
