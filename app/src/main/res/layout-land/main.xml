<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="4dp" />

            <TextView
                android:id="@+id/scene_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/stop_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_capture_button"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/action_stop"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/map_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_map_button"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/map"
                android:textColor="@color/map_button_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlay_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_overlay_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_overlay_window" />

            <Space
                android:layout_width="2dp"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_button"
                android:textColor="@color/overlay_button_text"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <com.rocom.nearby.map.MapCardView
        android:id="@+id/map_card"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/map_card"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_goneMarginStart="20dp">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <com.rocom.nearby.entity.NearbyListView
                android:id="@+id/nearby_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/nearby_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:text="@string/nearby_count"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/nearby_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.rocom.nearby.entity.NearbyListView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/empty_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="32dp"
        android:paddingEnd="72dp"
        android:paddingBottom="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <ImageView
            android:id="@+id/compass_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:alpha="0.5"
            android:src="@drawable/ic_compass" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="15dp" />

        <TextView
            android:id="@+id/card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_default"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="8dp" />

        <LinearLayout
            android:id="@+id/target_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/target_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/target_prefix"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <Space
                android:layout_width="3dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/target_input_layout"
                style="@style/Widget.Nearby.TargetInputLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.6">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/target_input"
                    style="@style/Widget.Nearby.TargetEditText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="30dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/action_button"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_capture_button"
            android:text="@string/action_start"
            android:textColor="@color/action_button_text"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
